<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
      <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SoulScreen.Core\SoulScreen.Core.csproj" />
    <ProjectReference Include="..\..\src\SoulScreen.AirPlay\SoulScreen.AirPlay.csproj" />
    <ProjectReference Include="..\..\src\SoulScreen.Media\SoulScreen.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app's WPF-free logic, compiled in directly: referencing the WPF app itself would
         make this whole suite Windows-desktop-only for the sake of a few pure functions. -->
    <Compile Include="..\..\src\SoulScreen.App\Logic\*.cs" Link="AppLogic\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
