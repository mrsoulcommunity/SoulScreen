<UserControl x:Class="SoulScreen.App.Controls.TileHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:rendering="clr-namespace:SoulScreen.App.Rendering"
             Background="{DynamicResource VideoBackground}"
             Focusable="True">

    <Border x:Name="Root" Background="{DynamicResource VideoBackground}">
        <Grid>
            <!-- Video area -->
            <Grid x:Name="VideoArea">
                <rendering:VideoSurface x:Name="Video" Stretch="Uniform">
                    <rendering:VideoSurface.LayoutTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="FlipTransform" ScaleX="1" ScaleY="1" />
                            <RotateTransform x:Name="RotationTransform" Angle="0" />
                        </TransformGroup>
                    </rendering:VideoSurface.LayoutTransform>
                </rendering:VideoSurface>

                <!-- Pause overlay -->
                <Border x:Name="PauseOverlay" Background="#88000000" Visibility="Collapsed">
                    <TextBlock Text="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="36"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Blocked state -->
                <Border x:Name="BlockedOverlay" Background="#CC1A1A1A" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="36"
                                   Foreground="#CC888888" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding BlockedMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Foreground="#CC888888" FontSize="13" Margin="0,8,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Tile chrome — bottom bar -->
            <Border x:Name="ChromeBar" VerticalAlignment="Bottom" Background="#88000000" Padding="8,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: name + model + latency -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Recording dot -->
                        <Ellipse x:Name="RecordingDot" Width="7" Height="7" Fill="#FF4444"
                                 Margin="0,0,5,0" Visibility="Collapsed"
                                 ToolTip="Recording this tile" />
                        <!-- Mic mute icon -->
                        <TextBlock x:Name="MicIcon" Text="&#xE720;" FontFamily="{StaticResource IconFont}"
                                   FontSize="11" Foreground="#CCFFFFFF" Margin="0,0,5,0"
                                   Visibility="Collapsed" ToolTip="Muted"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="DeviceName" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" ToolTip="{Binding Text, ElementName=DeviceName}" />
                        <TextBlock Text=" · " Foreground="#AAFFFFFF" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock x:Name="ModelName" Foreground="#AAFFFFFF" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text=" · " Foreground="#AAFFFFFF" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock x:Name="LatencyText" Foreground="#AAFFFFFF" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Right: per-tile toolbar (visible on hover) -->
                    <StackPanel x:Name="TileToolbar" Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="ScreenshotButton" Style="{StaticResource MiniButton}"
                                ToolTip="Screenshot (Ctrl+Shift+S)" Click="OnTileScreenshot" Margin="0,0,4,0"
                                Content="&#xE8B9;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                        <Button x:Name="RecordButton" Style="{StaticResource MiniButton}"
                                ToolTip="Record tile (Ctrl+Shift+R)" Click="OnTileRecord" Margin="0,0,4,0"
                                Content="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                        <Button x:Name="MuteButton" Style="{StaticResource MiniButton}"
                                ToolTip="Mute tile (Ctrl+M)" Click="OnTileMute" Margin="0,0,4,0"
                                Content="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                        <Button x:Name="SwapButton" Style="{StaticResource MiniButton}"
                                ToolTip="Swap to full" Click="OnTileSwap"
                                Content="&#xE8AB;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Approvals prompt overlay -->
            <Border x:Name="ApprovalOverlay" Background="#EE000000" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280">
                    <TextBlock Text="Allow this device?" FontSize="17" FontWeight="SemiBold"
                               Foreground="White" TextAlignment="Center" />
                    <TextBlock x:Name="ApprovalDeviceName" FontSize="14" Foreground="#CCCCCC"
                               TextAlignment="Center" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button x:Name="AllowButton" Content="Allow" Style="{StaticResource AccentButton}"
                                Margin="0,0,8,0" Click="OnApprovalAllow" />
                        <Button x:Name="BlockButton" Content="Block" Style="{StaticResource DefaultButton}"
                                Click="OnApprovalBlock" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>

    <UserControl.Resources>
        <Style x:Key="MiniButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="DefaultButton" TargetType="Button">
            <Setter Property="Background" Value="#444444" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>
</UserControl>
