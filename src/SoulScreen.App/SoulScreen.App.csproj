<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SoulScreen.Core\SoulScreen.Core.csproj" />
    <ProjectReference Include="..\SoulScreen.AirPlay\SoulScreen.AirPlay.csproj" />
    <ProjectReference Include="..\SoulScreen.Usb\SoulScreen.Usb.csproj" />
    <ProjectReference Include="..\SoulScreen.Android\SoulScreen.Android.csproj" />
    <ProjectReference Include="..\SoulScreen.Media\SoulScreen.Media.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DPAPI, for encrypting the PIN lock's hash to the current Windows user on disk. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- For the notification-area icon only; nothing else is drawn with WinForms. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\SoulScreen.ico</ApplicationIcon>
    <Version>1.3.0</Version>
    <AssemblyTitle>SoulScreen</AssemblyTitle>
    <Product>SoulScreen</Product>
    <Description>Mirror an iPhone screen onto Windows.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms brings global usings that collide with WPF's Size, Point, Color and
         Application; the one file that needs WinForms names it explicitly. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded so the tray icon can be loaded at runtime without reading the exe. -->
    <Resource Include="Assets\SoulScreen.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Removed: the XAML controls this file depends on have all been added to
         MainWindow.xaml, so it now compiles cleanly. -->
  </ItemGroup>

</Project>
